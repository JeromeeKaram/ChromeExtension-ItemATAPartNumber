{
  "manifest_version": 3,

  "name": "Chrome Extension - EIPD",
  "description": "",
  "version": "1.0",
  "icons": {
    "128": "icon.png",
    "48": "icon.png",
    "16": "icon.png"
  },

  "action": {
    "default_icon": "icon.png"
  },

  "background": {
    "service_worker": "eventPage.js"
  },

  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost/"
  ],

  "permissions": [
    "storage",
    "notifications",
    "contextMenus"
  ],
  "content_scripts": [
    {
      "matches": [ "http://127.0.0.1:8000/*", "http://localhost/*" ],
      "js": [ "content.js" ]
    }
  ]
}